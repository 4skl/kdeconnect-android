<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:keep="@xml/mousepadplugin_preferences_tv">

    <PreferenceCategory app:title="@string/pref_plugin_bigscreen">

        <SwitchPreference
            android:id="@+id/bigscreen_show_back"
            android:defaultValue="true"
            android:key="@string/pref_bigscreen_show_back"
            android:title="@string/bigscreen_show_back_title" />

        <SwitchPreference
            android:id="@+id/bigscreen_show_home"
            android:defaultValue="true"
            android:key="@string/pref_bigscreen_show_home"
            android:title="@string/bigscreen_show_home_title" />

        <SwitchPreference
            android:id="@+id/bigscreen_show_close"
            android:defaultValue="true"
            android:key="@string/pref_bigscreen_show_close"
            android:title="@string/bigscreen_show_close_title" />

        <SwitchPreference
            android:id="@+id/bigscreen_hide_mouse_input"
            android:defaultValue="false"
            android:key="@string/pref_bigscreen_hide_mouse_input"
            android:title="@string/bigscreen_hide_mouse_input" />
    </PreferenceCategory>

    <org.kde.kdeconnect.helpers.LongSummaryPreferenceCategory
        android:key="@string/screen_share_pref_category"
        android:title="@string/screen_share_settings_title">

        <ListPreference
            android:id="@+id/mousepad_screen_share_quality_preference"
            android:defaultValue="@string/screen_share_default_quality"
            android:entries="@array/screen_share_quality_entries"
            android:entryValues="@array/screen_share_quality_values"
            android:key="@string/screen_share_quality_key"
            android:summary="%s"
            android:title="@string/screen_share_quality_title" />

        <ListPreference
            android:id="@+id/mousepad_screen_share_fps_preference"
            android:defaultValue="@string/screen_share_default_fps"
            android:entries="@array/screen_share_fps_entries"
            android:entryValues="@array/screen_share_fps_values"
            android:key="@string/screen_share_fps_key"
            android:summary="%s"
            android:title="@string/screen_share_fps_title" />

    </org.kde.kdeconnect.helpers.LongSummaryPreferenceCategory>


</PreferenceScreen>
